---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { EMAIL, GITHUB, LINKEDIN } from '../consts';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Base title={t('contact.title.meta')} description={t('contact.description')} wide>
  <div class="container contact">
    <div class="intro">
      <p class="eyebrow">{t('contact.eyebrow')}</p>
      <h1>{t('contact.title')}</h1>
      <p class="muted">{t('contact.text')}</p>

      <ul class="side">
        <li>
          <span class="mono">{t('contact.email')}</span>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>
        <li>
          <span class="mono">GitHub</span>
          <a href={GITHUB}>{t('contact.github')}</a>
        </li>
        <li>
          <span class="mono">LinkedIn</span>
          <a href={LINKEDIN}>{t('contact.linkedin')}</a>
        </li>
      </ul>
    </div>

    <QuoteForm />
  </div>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-top: 4.5rem;
  }

  .intro {
    position: sticky;
    top: 6rem;
  }

  .side {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .side li {
    display: grid;
    gap: 0.15rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .side .mono {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .side a {
    color: var(--ink);
    text-decoration: none;
  }

  .side a:hover {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }

    .intro {
      position: static;
    }
  }
</style>
