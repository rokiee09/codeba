---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import Process from '../components/Process.astro';
import RiseWindow from '../components/RiseWindow.astro';
import AppShowcase from '../components/AppShowcase.astro';
import { projects } from '../data/projects';
import { services, pillars, icons } from '../data/services';
import { formatDate } from '../utils/date';
import { path, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const featured = projects.filter((p) => p.featured);
// yazılar şimdilik yalnızca Türkçe
const posts =
  lang === 'tr'
    ? (await getCollection('yazilar', ({ data }) => !data.draft))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, 3)
    : [];
---

<Base wide>
  <Hero />
  <RiseWindow />

  <section class="container block">
    <div class="head reveal">
      <p class="eyebrow">{t('home.services.eyebrow')}</p>
      <h2>{t('home.services.title')}</h2>
    </div>
    <div class="services">
      {
        services[lang].map((s) => (
          <div class="service reveal">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.icon]} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <AppShowcase />

  <section class="container block">
    <div class="value">
      <div class="head reveal">
        <p class="eyebrow">{t('home.value.eyebrow')}</p>
        <h2>{t('home.value.title')}</h2>
        <p class="muted">{t('home.value.text')}</p>
      </div>
      <ul class="pillars">
        {
          pillars[lang].map((p) => (
            <li class="reveal">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[p.icon]} />
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container block">
    <div class="head row reveal">
      <div>
        <p class="eyebrow">{t('home.works.eyebrow')}</p>
        <h2>{t('home.works.title')}</h2>
      </div>
      <a href={path('works', lang)} class="btn ghost">{t('home.works.all')}</a>
    </div>
    <div class="works">
      {featured.map((p) => <WorkCard project={p} />)}
    </div>
  </section>

  <section class="container block process">
    <div class="head reveal">
      <p class="eyebrow">{t('home.process.eyebrow')}</p>
      <h2>{t('home.process.title')}</h2>
    </div>
    <Process />
  </section>

  {
    posts.length > 0 && (
      <section class="container block">
        <div class="head reveal">
          <p class="eyebrow">{t('home.blog.eyebrow')}</p>
          <h2>{t('home.blog.title')}</h2>
        </div>
        <ul class="entries reveal">
          {posts.map((post) => (
            <li>
              <time class="when" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <a href={`/yazilar/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container block">
    <div class="contact reveal">
      <div class="glow" aria-hidden="true"></div>
      <p class="eyebrow">{t('home.contact.eyebrow')}</p>
      <h2>{t('home.contact.title')}</h2>
      <p class="muted">{t('home.contact.text')}</p>
      <a href={path('contact', lang)} class="btn">{t('hero.cta')}</a>
    </div>
  </section>
</Base>

<style>
  .block {
    padding-top: 7rem;
  }

  .head {
    margin-bottom: 2.5rem;
  }

  .head.row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
  }

  .service {
    background: var(--bg);
    padding: 1.75rem 1.5rem 1.5rem;
    min-width: 0;
    transition: background 0.25s;
  }

  .service:hover {
    background: var(--surface);
  }

  .icon {
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.6rem;
    margin-bottom: 2rem;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--bg-2);
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 560px) {
    .service .icon {
      margin-bottom: 1.1rem;
    }
  }

  .service p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .value {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .value .muted {
    max-width: 30rem;
  }

  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
  }

  .pillars li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: var(--bg);
    padding: 1.5rem;
    min-width: 0;
  }

  .pillars .icon {
    margin-bottom: 0;
    flex: none;
  }

  .pillars h3 {
    font-size: 1.1rem;
  }

  .pillars p {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  @media (max-width: 820px) {
    .value {
      grid-template-columns: 1fr;
    }
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.75rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.5rem;
    counter-reset: none;
  }

  .steps li {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    min-width: 0;
  }

  .step-n {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 0.85rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .steps p {
    margin: 0;
    color: var(--soft);
  }

  .contact {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(3rem, 8vw, 5.5rem) 1.5rem;
    border-radius: 24px;
    border: 1px solid var(--rule);
    background: var(--surface);
    isolation: isolate;
  }

  .glow {
    position: absolute;
    z-index: -1;
    width: 40rem;
    max-width: 120%;
    aspect-ratio: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -30%);
    background: radial-gradient(circle, rgba(79, 140, 255, 0.22), rgba(79, 140, 255, 0.06) 40%, transparent 65%);
    filter: blur(20px);
    animation: breathe 8s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      transform: translate(-50%, -38%) scale(1.12);
    }
  }

  .contact .eyebrow {
    justify-content: center;
  }

  .contact h2 {
    font-size: clamp(2rem, 5vw, 3.4rem);
  }

  .contact .muted {
    max-width: 30rem;
    margin: 0 auto 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>
