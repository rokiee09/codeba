---
import Base from '../layouts/Base.astro';
import { path, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const certTech = [
  'React', 'React Native', 'Expo', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Sass',
  'Bootstrap', 'Zustand', 'React Hook Form', 'Figma', 'Postman', 'GitHub', 'VS Code',
];
---

<Base title={t('about.metaTitle')} description={t('about.description')}>
  <p class="eyebrow">codeba</p>
  <h1>{t('about.title')}</h1>
  <p>{t('about.p1')}</p>
  <p>{t('about.p2')}</p>
  <p>{t('about.p3')}</p>

  <h2 class="section-label">{t('about.cert')}</h2>
  <article class="cert">
    <header class="cert-head">
      <span class="seal" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="6" /><path d="M8.5 13.8 7 22l5-2.6 5 2.6-1.5-8.2" /><path d="m9.6 9 1.7 1.7 3.1-3.3" /></svg>
      </span>
      <div>
        <h3>{t('about.certTitle')}</h3>
        <p class="meta mono">{t('about.certOrg')} · {t('about.certDate')}</p>
      </div>
    </header>

    <p class="cert-text">{t('about.certText')}</p>

    <p class="tech-label mono">{t('about.certTech')}</p>
    <ul class="tech">
      {certTech.map((x) => <li>{x}</li>)}
    </ul>
  </article>

  <h2 class="section-label">{t('about.tools')}</h2>
  <p>{t('about.toolsText')}</p>

  <p><a href={path('contact', lang)} class="btn">{t('about.cta')}</a></p>
</Base>

<style>
  p {
    color: var(--soft);
  }

  .cert {
    position: relative;
    margin: 1rem 0 0.5rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid var(--rule);
    border-radius: 14px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(79, 140, 255, 0.08), transparent 60%),
      #111318;
    overflow: hidden;
  }

  .cert::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(#4f8cff, rgba(79, 140, 255, 0));
  }

  .cert-head {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .seal {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.3);
  }

  .seal svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: #8fb3ff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cert h3 {
    margin: 0;
    font-size: clamp(1.02rem, 2.4vw, 1.18rem);
    line-height: 1.35;
    color: var(--ink);
  }

  .meta {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .cert-text {
    margin: 1rem 0 1.2rem;
  }

  .tech-label {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech li {
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--soft);
  }

</style>
