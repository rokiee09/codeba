---
import { getLang, path, useT } from '../i18n';
const lang = getLang(Astro.url);
const t = useT(lang);
const stack = ['Flutter', 'React Native', 'React', 'TypeScript', 'Astro', 'Android', 'WordPress', 'Figma'];

// başlık kelime kelime belirsin; bazı kelimelerin yanında Figma'daki gibi imleç rozeti çıksın
const titleWords = t('hero.title').split(' ');
const subWords = t('hero.sub').split(' ');
const titleTags: Record<number, { label: string; color: string }> = {
  1: { label: 'Flutter', color: 'blue' },
  4: { label: lang === 'tr' ? 'Canlı' : 'Live', color: 'green' },
};
const subTags: Record<number, { label: string; color: string }> =
  lang === 'tr' ? { 1: { label: 'Astro', color: 'orange' } } : { 3: { label: 'Astro', color: 'orange' } };
let n = 0;
const stages = lang === 'tr' ? ['Tel çerçeve', 'Tasarım', 'Kod', 'Yayında'] : ['Wireframe', 'Design', 'Code', 'Live'];
const dragHint = lang === 'tr' ? 'Sürükleyip çevir' : 'Drag to rotate';
---

<section class="hero">
  <canvas id="voxels" aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>
  <canvas id="devices" aria-label={t('hero.scene')} role="img" data-lang={lang}></canvas>
  <div class="stages" aria-hidden="true">
    <ol>
      {stages.map((s, i) => <li data-i={i} class={i === 0 ? 'on' : ''}><span class="sn">{i + 1}</span>{s}</li>)}
    </ol>
    <span class="hint">↔ {dragHint}</span>
  </div>
  <div class="container inner">
    <p class="status rise-in" style="--i:0"><span class="pulse"></span>{t('hero.status')}</p>
    <h1 aria-label={`${t('hero.title')} ${t('hero.sub')}`}>
      <span aria-hidden="true">
        {
          titleWords.map((w, i) => (
            <span class="w" style={`--i:${n++}`}>
              {w}
              {titleTags[i] && (
                <span class={`ctag ${titleTags[i].color}${i > 1 ? ' extra' : ''}`} style={`--d:${i}`} data-label={titleTags[i].label}>
                  <svg viewBox="0 0 12 12"><path d="M1 1l9.5 4-4 1.5L5 10.5z" /></svg>
                </span>
              )}
            </span>
          ))
        }
        <span class="sub">
          {
            subWords.map((w, i) => (
              <span class="w" style={`--i:${n++}`}>
                {w}
                {subTags[i] && (
                  <span class={`ctag ${subTags[i].color} extra`} style={`--d:${i + 5}`} data-label={subTags[i].label}>
                    <svg viewBox="0 0 12 12"><path d="M1 1l9.5 4-4 1.5L5 10.5z" /></svg>
                  </span>
                )}
              </span>
            ))
          }
        </span>
      </span>
    </h1>
    <p class="lede rise-in" style="--i:11">{t('hero.lede')}</p>
    <div class="actions rise-in" style="--i:13">
      <a href={path('contact', lang)} class="btn">{t('hero.cta')}</a>
      <a href={path('works', lang)} class="btn ghost">{t('hero.works')}</a>
    </div>
  </div>
  <div class="stack container" aria-label={t('hero.stackAria')}>
    <span class="label mono">{t('hero.stack')}</span>
    <ul>
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<script>
  import { initVoxels } from '../scripts/voxels';
  import { initDevices } from '../scripts/devices';

  // WebGL yoksa sayfa yine çalışır, sadece 3D kısımlar görünmez
  const start = (id: string, init: (c: HTMLCanvasElement) => void) => {
    const c = document.getElementById(id) as HTMLCanvasElement | null;
    if (!c || getComputedStyle(c).display === 'none') return;
    try {
      init(c);
    } catch {
      c.remove();
    }
  };
  start('voxels', initVoxels);
  start('devices', initDevices);

  // 3D sahne aşama değiştirdikçe alttaki göstergeyi güncelle
  const dev = document.getElementById('devices');
  const items = document.querySelectorAll<HTMLElement>('.stages li');
  dev?.addEventListener('stage', (e) => {
    const i = (e as CustomEvent<number>).detail;
    items.forEach((li) => li.classList.toggle('on', Number(li.dataset.i) === i));
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: min(90vh, 800px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  #voxels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }

  #devices {
    position: absolute;
    top: 0;
    right: 0;
    width: 56%;
    height: 100%;
    z-index: 0;
  }

  .stages {
    position: absolute;
    right: 0;
    bottom: 5.5rem;
    width: 56%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    pointer-events: none;
  }

  .stages ol {
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(17, 19, 24, 0.75);
    backdrop-filter: blur(8px);
  }

  .stages li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--muted);
    padding: 0.3rem 0.75rem 0.3rem 0.35rem;
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
    white-space: nowrap;
  }

  .stages .sn {
    display: inline-grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 0.66rem;
    border: 1px solid var(--rule);
  }

  .stages li.on {
    background: rgba(79, 140, 255, 0.16);
    color: var(--ink);
  }

  .stages li.on .sn {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .stages li[data-i='3'].on {
    background: rgba(62, 207, 142, 0.14);
  }

  .stages li[data-i='3'].on .sn {
    background: #3ecf8e;
    border-color: #3ecf8e;
  }

  .stages .hint {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: #5b616b;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 34% 50% at 74% 50%, rgba(10, 11, 14, 0.85), transparent 72%),
      linear-gradient(90deg, var(--bg) 0%, rgba(10, 11, 14, 0.9) 38%, rgba(10, 11, 14, 0.1) 72%),
      linear-gradient(0deg, var(--bg) 0%, rgba(10, 11, 14, 0) 35%);
  }

  .inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: 6rem 3rem;
    pointer-events: none;
  }

  .inner > * {
    max-width: 38rem;
    pointer-events: auto;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--soft);
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(20, 22, 28, 0.6);
    margin-bottom: 1.75rem;
  }

  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3ecf8e;
    box-shadow: 0 0 0 0 rgba(62, 207, 142, 0.6);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(62, 207, 142, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(62, 207, 142, 0);
    }
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
  }

  .sub {
    display: block;
    color: var(--muted);
  }

  /* açılış: kelimeler bulanıktan netleşerek sırayla gelir */
  .w {
    position: relative;
    display: inline-block;
    margin-right: 0.22em;
    animation: wordIn 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.07s);
  }

  @keyframes wordIn {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  .rise-in {
    animation: wordIn 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.07s);
  }

  /* imleç rozetleri: kelimenin üstünde, birisi o an çalışıyormuş gibi */
  .ctag {
    position: absolute;
    left: 70%;
    top: -0.55em;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    color: #fff;
    padding: 0.32rem 0.55rem 0.32rem 0.45rem;
    border-radius: 0 999px 999px 999px;
    white-space: nowrap;
    pointer-events: none;
    animation:
      tagIn 0.5s cubic-bezier(0.3, 1.4, 0.4, 1) both,
      tagFloat 5s ease-in-out infinite;
    animation-delay: calc(1.1s + var(--d) * 0.12s), calc(1.6s + var(--d) * 0.3s);
  }

  /* rozet yazısı CSS'ten gelir; sayfa metnine (ve Google'ın okuduğu başlığa) karışmaz */
  .ctag::after {
    content: attr(data-label);
  }

  .ctag svg {
    position: absolute;
    left: -0.62rem;
    top: -0.62rem;
    width: 0.75rem;
    height: 0.75rem;
  }

  .ctag.blue { background: #3b82f6; }
  .ctag.blue svg { fill: #3b82f6; }
  .ctag.green { background: #22a861; }
  .ctag.green svg { fill: #22a861; }
  .ctag.orange { background: #f0702d; }
  .ctag.orange svg { fill: #f0702d; }

  @media (max-width: 900px) {
    .ctag {
      font-size: 0.68rem;
      top: -0.75em;
    }

    .ctag.extra {
      display: none;
    }
  }

  @keyframes tagIn {
    from {
      opacity: 0;
      transform: translate(-0.6rem, 0.6rem) scale(0.6);
    }
  }

  @keyframes tagFloat {
    50% {
      translate: 0.35rem -0.3rem;
    }
  }

  .lede {
    font-size: 1.1rem;
    color: var(--soft);
    max-width: 33rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .stack {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 2rem;
  }

  .label {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stack ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
  }

  .stack li {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: #6f7580;
  }

  /* dar ekranda sahne metnin altına, akışın içine iner */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
    }

    #devices {
      position: relative;
      order: 2;
      width: 100%;
      height: clamp(260px, 70vw, 380px);
      margin-top: -1rem;
    }

    .inner {
      padding-block: 4rem 0;
    }

    .stack {
      order: 4;
    }

    .stages {
      position: relative;
      order: 3;
      width: 100%;
      bottom: auto;
      margin-top: 0.5rem;
    }

    .stages li {
      padding-right: 0.55rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 420px) {
    .stages {
      padding-inline: max(1rem, env(safe-area-inset-left, 0px));
    }

    .stages ol {
      gap: 0.1rem;
      padding: 0.2rem;
      max-width: 100%;
    }

    .stages li:not(.on) {
      font-size: 0;
      gap: 0;
      padding-right: 0.35rem;
    }
  }

  @media (max-width: 700px) {
    .shade {
      background: linear-gradient(0deg, var(--bg) 12%, rgba(10, 11, 14, 0.8) 60%, rgba(10, 11, 14, 0.5) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w,
    .rise-in,
    .ctag {
      animation: none;
    }

    .pulse {
      animation: none;
    }
  }
</style>
