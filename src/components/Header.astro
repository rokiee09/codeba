---
import LogoMark from './LogoMark.astro';
import LangSwitch from './LangSwitch.astro';
import { getCollection } from 'astro:content';
import { getLang, path, useT } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang);
// yayında yazı yoksa menüde "Yazılar" görünmesin
const hasPosts = (await getCollection('yazilar', ({ data }) => !data.draft)).length > 0;

const links =
  lang === 'tr'
    ? [
        { href: path('works', 'tr'), label: t('nav.works') },
        ...(hasPosts ? [{ href: '/yazilar/', label: t('nav.blog') }] : []),
        { href: path('about', 'tr'), label: t('nav.about') },
      ]
    : [
        { href: path('works', 'en'), label: t('nav.works') },
        { href: path('about', 'en'), label: t('nav.about') },
      ];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href.replace(/\/$/, ''));
const menuLabel = lang === 'tr' ? 'Menü' : 'Menu';
---

<header class="site-header" data-open="false">
  <div class="container bar">
    <a href={path('home', lang)} class="logo" aria-label={t('nav.home')}>
      <LogoMark size={30} /><span>codeba<span class="tld">.dev</span></span>
    </a>

    <nav id="main-nav" class="nav" aria-label={menuLabel}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href={path('contact', lang)} class="cta">{t('nav.cta')}</a>
    </nav>

    <div class="tools">
      <LangSwitch />
      <button type="button" class="burger" aria-controls="main-nav" aria-expanded="false" aria-label={menuLabel}>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // telefon ve tablette menü aç/kapa
  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = header?.querySelector<HTMLButtonElement>('.burger');
  if (header && burger) {
    const set = (v: boolean) => {
      header.dataset.open = String(v);
      burger.setAttribute('aria-expanded', String(v));
      document.documentElement.classList.toggle('menu-open', v);
    };
    burger.addEventListener('click', () => set(header.dataset.open !== 'true'));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.dataset.open === 'true') {
        set(false);
        burger.focus();
      }
    });
    window.matchMedia('(min-width: 821px)').addEventListener('change', (m) => m.matches && set(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgba(10, 11, 14, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 0.8rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .tld {
    color: var(--muted);
    font-weight: 400;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.4rem;
    font-size: 0.9rem;
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  .nav .cta {
    color: var(--ink);
    border: 1px solid var(--rule);
    padding: 0.42rem 0.95rem;
    border-radius: 999px;
  }

  .nav .cta:hover {
    border-color: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .burger {
    display: none;
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--bg-2);
    cursor: pointer;
  }

  .burger span {
    position: absolute;
    left: 50%;
    width: 1.05rem;
    height: 1.5px;
    margin-left: -0.525rem;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.25s, top 0.25s;
  }

  .burger span:first-child { top: calc(50% - 4px); }
  .burger span:last-child { top: calc(50% + 3px); }

  .site-header[data-open='true'] .burger span:first-child {
    top: 50%;
    transform: rotate(45deg);
  }

  .site-header[data-open='true'] .burger span:last-child {
    top: 50%;
    transform: rotate(-45deg);
  }

  .burger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* telefon ve dikey tablet: linkler açılır panele taşınır */
  @media (max-width: 820px) {
    .burger {
      display: block;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem max(1.25rem, env(safe-area-inset-right, 0px)) 1.5rem max(1.25rem, env(safe-area-inset-left, 0px));
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      z-index: 1;
      isolation: isolate;
      min-height: calc(100dvh - 100%);
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
      font-size: 1.15rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition: opacity 0.2s, transform 0.25s, visibility 0s 0.25s;
    }

    .site-header[data-open='true'] .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.2s, transform 0.25s;
    }

    .nav a {
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--rule);
      color: var(--soft);
    }

    .nav .cta {
      margin-top: 1.25rem;
      text-align: center;
      border: 0;
      background: var(--ink);
      color: var(--bg);
      padding: 0.9rem;
      border-radius: 999px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .burger span {
      transition: none !important;
    }
  }
</style>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
