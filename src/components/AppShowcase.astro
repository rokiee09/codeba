---

import { getLang, useT } from '../i18n';
const lang = getLang(Astro.url);
const t = useT(lang);
const days = t('app.days').split(',');
const DONE = [true, true, true, true, true, false, false];
---

<section class="container block app-sec" id="uygulama">
  <div class="app-grid">
    <div class="app-copy reveal">
      <p class="eyebrow">{t('app.eyebrow')}</p>
      <h2>{t('app.title')}</h2>
      <p class="muted">{t('app.text')}</p>
      <ul class="app-list">
        <li><span class="ok">✓</span>{t('app.b1')}</li>
        <li><span class="ok">✓</span>{t('app.b2')}</li>
        <li><span class="ok">✓</span>{t('app.b3')}</li>
      </ul>
      <button type="button" class="btn ghost app-replay">↻ {t('app.replay')}</button>
    </div>
    <div class="app-stage">
      <span class="app-badge">{t('app.badge')}</span>
      <div class="phone" role="img" aria-label={t('app.aria')} data-locale={lang === 'tr' ? 'tr-TR' : 'en-US'}>
        <div class="island"></div>
        <div class="screen">
          <div class="sbar"><span>9:41</span><span class="sicons"><i></i><i></i><i class="bat"></i></span></div>
          <div class="a-head" data-a>
            <div><span class="d-num">23</span><span class="d-mon">{t('app.month')} <svg viewBox="0 0 10 6"><path d="M1 1l4 4 4-4"/></svg></span></div>
            <div class="h-icons"><svg viewBox="0 0 20 20"><rect x="3" y="4.5" width="14" height="12" rx="2.5"/><path d="M3 8.5h14M7 2.5v4M13 2.5v4"/></svg><svg viewBox="0 0 20 20"><circle cx="7.5" cy="7" r="2.6"/><circle cx="13.5" cy="7.5" r="2.2"/><path d="M2.5 16c.6-3 2.6-4.5 5-4.5s4.4 1.5 5 4.5M12 11.6c2.6-.3 4.6 1.2 5.3 4"/></svg></div>
          </div>
          <div class="week">{days.map((d, i) => (
              <div class={`day${DONE[i] ? ' done' : ''}${i === 4 ? ' today' : ''}`} data-d>
                <span class="dl">{d}</span>
                <svg viewBox="0 0 20 24"><path d="M10 2.5C7 7 4 10.4 4 14.2a6 6 0 0 0 12 0C16 10.4 13 7 10 2.5z" /></svg>
                <span class="dn">{19 + i}</span>
              </div>
            ))}</div>
          <div class="gauge">
            <svg viewBox="0 0 240 140">
              <defs>
                <linearGradient id="gg" x1="0" x2="1"><stop offset="0" stop-color="#7cc4ff"/><stop offset="1" stop-color="#2f7bff"/></linearGradient>
                <filter id="gl" x="-20%" y="-20%" width="140%" height="160%"><feGaussianBlur stdDeviation="7"/></filter>
              </defs>
              <path class="g-track" d="M30 125 A90 90 0 0 1 210 125"/>
              <path class="g-glow" d="M30 125 A90 90 0 0 1 210 125" pathLength="100" filter="url(#gl)"/>
              <path class="g-fill" d="M30 125 A90 90 0 0 1 210 125" pathLength="100"/>
            </svg>
            <div class="g-center">
              <span class="g-num" data-to="2150">0</span>
              <span class="g-unit">{t('app.unit')}</span>
            </div>
          </div>
          <p class="g-goal" data-a>{t('app.goal')}</p>
          <p class="g-pct" data-a>{t('app.pct')}</p>
          <div class="a-chips">
            <span class="a-chip" data-c><svg viewBox="0 0 20 20"><path d="M5 3h10l-1.4 13a2 2 0 0 1-2 1.8H8.4a2 2 0 0 1-2-1.8z"/><path d="M5.6 8.5h8.8"/></svg>{t('app.c1')}</span>
            <span class="a-chip" data-c><svg viewBox="0 0 20 20"><path d="M11 2 4 11h5l-1 7 7-9h-5z"/></svg>{t('app.c2')}</span>
            <span class="a-chip a-icon" data-c role="img" aria-label={t('app.c3')}><svg viewBox="0 0 20 20"><path d="M10 13V3M6.5 6.5 10 3l3.5 3.5M4 11v4.5A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5V11"/></svg></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  function ease(t) { t = Math.min(1, Math.max(0, t)); return 1 - Math.pow(1 - t, 3); }
  function seg(t, a, b) { return Math.min(1, Math.max(0, (t - a) / (b - a))); }
  document.querySelectorAll('.app-sec').forEach(function (sec) {
    var phone = sec.querySelector('.phone');
    var heads = phone.querySelectorAll('[data-a]');
    var days = phone.querySelectorAll('[data-d]');
    var chips = phone.querySelectorAll('[data-c]');
    var fill = phone.querySelector('.g-fill'), glow = phone.querySelector('.g-glow'), num = phone.querySelector('.g-num');
    var to = +num.dataset.to, fmt = new Intl.NumberFormat(phone.dataset.locale || 'tr-TR');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var raf = 0, t0 = 0;
    function pop(el, k, dy) { el.style.opacity = k; el.style.transform = 'translateY(' + (1 - k) * (dy || 10) + 'px) scale(' + (0.85 + 0.15 * k) + ')'; }
    function frame(t) {
      pop(heads[0], ease(seg(t, 0, 500)), 12);
      days.forEach(function (d, i) { pop(d, ease(seg(t, 300 + i * 90, 650 + i * 90)), 8); });
      var g = ease(seg(t, 1000, 2600));
      var off = 100 - 86 * g;
      fill.style.strokeDashoffset = off; glow.style.strokeDashoffset = off;
      num.textContent = fmt.format(Math.round(to * g));
      pop(heads[1], ease(seg(t, 2200, 2600)), 6);
      pop(heads[2], ease(seg(t, 2350, 2750)), 6);
      chips.forEach(function (c, i) { pop(c, ease(seg(t, 2600 + i * 130, 3000 + i * 130)), 14); });
    }
    function play() {
      cancelAnimationFrame(raf);
      if (reduce) { frame(99999); return; }
      t0 = performance.now();
      (function loop(now) { var t = now - t0; frame(t); if (t < 3600) raf = requestAnimationFrame(loop); })(t0);
    }
    frame(reduce ? 99999 : 0);
    var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { play(); io.disconnect(); } }, { threshold: 0.45 });
    io.observe(phone);
    sec.querySelector('.app-replay').addEventListener('click', play);
  });
})();
</script>

<style>
  .app-sec {
    padding-top: 7rem;
  }
  .app-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .app-copy .muted { max-width: 30rem; }
  .app-list { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: .6rem; }
  .app-list li { display: flex; align-items: center; gap: .65rem; color: var(--soft); }
  .app-list .ok { display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: rgba(79,140,255,.16); color: var(--accent); font-size: .72rem; flex: none; }
  .app-replay { cursor: pointer; font: inherit; font-family: var(--mono); font-size: .85rem; }
  .app-stage { position: relative; display: grid; place-items: center; padding-top: 2rem; }
  .app-stage::before { content: ""; position: absolute; width: 26rem; max-width: 110%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(79,140,255,.28), transparent 65%); filter: blur(10px); }
  .app-badge { position: absolute; top: 0; left: 50%; transform: translateX(-50%); font-family: var(--mono); font-size: .7rem; letter-spacing: .06em; color: var(--muted); border: 1px solid var(--rule); border-radius: 999px; padding: .2rem .7rem; background: var(--bg); z-index: 2; white-space: nowrap; }
  .phone { position: relative; width: 300px; height: 620px; border-radius: 52px; background: #1d1f24; padding: 11px; box-shadow: inset 0 0 0 2px #3a3d44, 0 40px 80px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.06); font-family: var(--sans); }
  .phone::before, .phone::after { content: ""; position: absolute; left: -3px; width: 3px; border-radius: 2px 0 0 2px; background: #2c2f36; }
  .phone::before { top: 120px; height: 34px; } .phone::after { top: 170px; height: 58px; }
  .island { position: absolute; top: 22px; left: 50%; transform: translateX(-50%); width: 92px; height: 27px; border-radius: 20px; background: #000; z-index: 3; }
  .screen { position: relative; height: 100%; border-radius: 42px; background: #fff; color: #111318; overflow: hidden; padding: 16px 20px 20px; display: flex; flex-direction: column; }
  .sbar { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 14px; padding: 0 8px; height: 30px; }
  .sicons { display: flex; gap: 5px; align-items: center; }
  .sicons i { display: block; width: 15px; height: 9px; border-radius: 2px; background: #111318; }
  .sicons i:first-child { width: 13px; clip-path: polygon(0 100%, 25% 70%, 25% 100%, 37% 100%, 37% 50%, 62% 50%, 62% 100%, 75% 100%, 75% 20%, 100% 0, 100% 100%); }
  .sicons .bat { width: 22px; height: 11px; border-radius: 3px; background: transparent; box-shadow: inset 0 0 0 1.5px #111318, inset 0 0 0 3px #fff, inset 0 0 0 9px #111318; }
  .a-head { display: flex; justify-content: space-between; align-items: center; margin: 14px 0 12px; }
  .d-num { font-size: 40px; font-weight: 700; letter-spacing: -2px; }
  .d-mon { font-size: 19px; font-weight: 600; margin-left: 4px; }
  .d-mon svg { width: 10px; height: 6px; fill: none; stroke: #111318; stroke-width: 1.6; margin-left: 2px; vertical-align: middle; }
  .h-icons { display: flex; gap: 12px; }
  .h-icons svg { width: 21px; height: 21px; fill: none; stroke: #111318; stroke-width: 1.7; stroke-linecap: round; }
  .week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 6px; }
  .day { display: grid; justify-items: center; gap: 4px; }
  .dl { font-size: 10px; font-weight: 600; color: #9aa0aa; }
  .day svg { width: 22px; height: 26px; fill: #f0f2f5; stroke: #d5d9e0; stroke-width: 1.3; }
  .day.done svg { fill: #4f9cff; stroke: #2f7bff; }
  .dn { font-size: 10px; color: #9aa0aa; }
  .day.today .dn { color: #111318; font-weight: 700; position: relative; }
  .day.today .dn::after { content: ""; position: absolute; left: 50%; bottom: -6px; width: 4px; height: 4px; border-radius: 50%; background: #ff8a3d; transform: translateX(-50%); }
  .gauge { position: relative; margin: 14px -6px 0; }
  .gauge svg { width: 100%; display: block; overflow: visible; }
  .g-track, .g-fill, .g-glow { fill: none; stroke-width: 26; stroke-linecap: round; }
  .g-track { stroke: #e8f1ff; }
  .g-fill { stroke: url(#gg); stroke-dasharray: 100; stroke-dashoffset: 100; }
  .g-glow { stroke: #5aa8ff; opacity: .55; stroke-dasharray: 100; stroke-dashoffset: 100; }
  .g-center { position: absolute; left: 0; right: 0; bottom: 4px; display: grid; justify-items: center; }
  .g-num { font-size: 46px; font-weight: 700; letter-spacing: -2px; line-height: 1; font-variant-numeric: tabular-nums; }
  .g-unit { font-size: 13px; color: #8a909a; margin-top: 2px; }
  .g-goal { text-align: center; font-size: 13px; font-weight: 600; margin: 12px 0 2px; }
  .g-pct { text-align: center; font-size: 12.5px; font-weight: 600; color: #e0a100; margin: 0; }
  .a-chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: auto; }
  .a-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 8px 10px; border-radius: 999px; background: #fff; box-shadow: 0 2px 10px rgba(17,19,24,.09), 0 0 0 1px #eef0f3; white-space: nowrap; }
  .a-chip svg { width: 13px; height: 13px; fill: none; stroke: #2f7bff; stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; }
  .a-chip.a-icon { padding: 8px; }
  [data-a], [data-d], [data-c] { will-change: transform, opacity; }
  @media (max-width: 860px) { .app-grid { grid-template-columns: 1fr; } }
  @media (max-width: 380px) { .phone { transform: scale(.88); margin: -36px 0; } }
</style>
