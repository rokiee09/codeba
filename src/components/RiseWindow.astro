    "rise.aria": "Sample web dashboard",
    "rise.eyebrow": "Sample web dashboard · zooms in as you scroll",
    "rise.url": "app.sampleclinic.com",
    "rise.brand": "Clinic",
    "rise.n1": "Overview",
    "rise.n2": "Appointments",
    "rise.n3": "Clients",
    "rise.n4": "Reports",
    "rise.n5": "Settings",
    "rise.hello": "Good morning",
    "rise.date": "Friday, October 23",
    "rise.new": "New appointment",
    "rise.s1": "Today's appointments",
    "rise.s2": "This week",
    "rise.s3": "Occupancy",
    "rise.c1": "Time",
    "rise.c2": "Client",
    "rise.c3": "Service",
