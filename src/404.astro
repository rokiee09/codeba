---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı" wide noindex>
  <section class="nf">
    <canvas id="wire" role="img" aria-label="Sürüklenip çevrilebilen çizgi laptop ve telefon modeli"></canvas>
    <div class="hud tl">codeba</div>
    <div class="hud tr">HATA 404</div>
    <div class="hud bl">SÜRÜKLE VE ÇEVİR</div>
    <div class="hud br">rota ? · durum kayıp · telefon havada</div>
    <div class="nf-text">
      <h1>404</h1>
      <p>Bu sayfa sensiz yayına çıktı.</p>
      <a href="/" class="nf-btn">ANA SAYFAYA DÖN</a>
    </div>
  </section>
</Base>

<script>
  import * as THREE from 'three';
  // @ts-ignore düz JS modülü
  import { runWire } from '../scripts/wire-core.js';
  const c = document.getElementById('wire') as HTMLCanvasElement | null;
  if (c) {
    try {
      runWire(THREE, c);
    } catch {
      c.remove();
    }
  }
</script>

<style>
  .nf {
    position: relative;
    height: calc(100vh - 4.5rem);
    min-height: 32rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 50% 70%, #14171e 0%, transparent 70%),
      var(--bg);
  }

  #wire {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .nf-text {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    padding-top: clamp(2.5rem, 8vh, 5rem);
    text-align: center;
    pointer-events: none;
  }

  .nf-text h1 {
    font-family: var(--mono);
    font-weight: 400;
    font-size: clamp(4.5rem, 14vw, 8rem);
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0 0 0.75rem;
  }

  .nf-text p {
    font-family: var(--mono);
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .nf-btn {
    pointer-events: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: #0a0b0e;
    background: var(--ink);
    padding: 0.7rem 1.2rem;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .nf-btn:hover {
    background: #fff;
  }

  .hud {
    position: absolute;
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: #4b515c;
    pointer-events: none;
  }

  .tl { top: 1rem; left: max(1rem, env(safe-area-inset-left, 0px)); }
  .tr { top: 1rem; right: max(1rem, env(safe-area-inset-right, 0px)); }
  .bl { bottom: 1rem; left: max(1rem, env(safe-area-inset-left, 0px)); }
  .br { bottom: 1rem; right: max(1rem, env(safe-area-inset-right, 0px)); }

  @media (max-width: 520px) {
    .br {
      display: none;
    }
  }
</style>
