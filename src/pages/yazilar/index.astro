---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../utils/date';

const posts = (await getCollection('yazilar', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
---

<Base title="Yazılar" description="Yazılım, Flutter ve otomasyon üzerine notlar.">
  <h1>Yazılar</h1>

  {
    [...byYear.entries()].map(([year, list]) => (
      <section>
        <h2 class="section-label">{year}</h2>
        <ul class="entries">
          {list.map((post) => (
            <li>
              <time class="when" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <a href={`/yazilar/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {posts.length === 0 && <p class="muted">Henüz yazı yok.</p>}
</Base>
