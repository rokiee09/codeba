---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('yazilar', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <time class="mono muted" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
  <p class="back mono"><a href="/yazilar/">← tüm yazılar</a></p>
</Base>

<style>
  .post-head {
    margin-bottom: 2.25rem;
  }

  .post-head h1 {
    margin-bottom: 0.4rem;
  }

  .post-body :global(h2) {
    font-size: 1.2rem;
  }

  .back {
    margin-top: 3rem;
  }

  .back a {
    text-decoration: none;
    color: var(--muted);
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
